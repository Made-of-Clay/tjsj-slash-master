{
  "useTabs": false,
  "tabWidth": 4,
  "ignorePatterns": ["**/public/**"],
  "overrides": [
    {
      "files": ["*.html", "*.json", "*.md", "*.yml", "*.yaml"],
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": ["*.js", "*.ts"],
      "options": {
        "singleQuote": true
      }
    }
  ]
}
